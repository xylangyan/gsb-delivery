                        "required": true,
                        "name": "Media_Type"
                    },
                    {
                        "datatype": "anyURI",
                        "propertyUrl": "http://cldf.clld.org/v1.0/terms.rdf#downloadUrl",
                        "required": false,
                        "name": "Download_URL"
                    },
                    {
                        "datatype": "string",
                        "propertyUrl": "http://cldf.clld.org/v1.0/terms.rdf#pathInZip",
                        "required": false,
                        "name": "Path_In_Zip"
                    }
                ],
