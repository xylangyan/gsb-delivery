<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx"
    xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata">
    <edmx:DataServices m:DataServiceVersion="2.0">
        <Schema Namespace="EventModel" xmlns="http://schemas.microsoft.com/ado/2006/04/edm">
            <EntityContainer Name="EventContainer" m:IsDefaultEntityContainer="true">
                <EntitySet Name="Events" EntityType="EventModel.Event"/>
            </EntityContainer>
            <EntityType Name="Event">
                <Key>
                    <PropertyRef Name="Source"/>
                    <PropertyRef Name="Effective"/>
                </Key>
                <Property Name="Source" Type="Edm.String" Nullable="false"
                    MaxLength="128" FixedLength="false" Unicode="true"/>
                <Property Name="Effective" Type="Edm.DateTimeOffset"
                    Nullable="false" Precision="7"/>
                <Property Name="Sentinel" Type="Edm.String" Nullable="true"
                    MaxLength="64" FixedLength="false" Unicode="true"/>
            </EntityType>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>
