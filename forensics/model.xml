<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx"
    xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata">
    <edmx:DataServices m:DataServiceVersion="2.0">
        <Schema Namespace="Inventory" xmlns="http://schemas.microsoft.com/ado/2006/04/edm">
            <EntityContainer Name="InventoryContainer" m:IsDefaultEntityContainer="true">
                <EntitySet Name="Products" EntityType="Inventory.Product"/>
                <EntitySet Name="Categories" EntityType="Inventory.Category"/>
                <AssociationSet Name="Products_Categories" Association="Inventory.Products_Categories">
                    <End Role="Category" EntitySet="Categories"/>
                    <End Role="Product" EntitySet="Products"/>
                </AssociationSet>
            </EntityContainer>
            <EntityType Name="Product">
                <Key>
                    <PropertyRef Name="ProductID"/>
                </Key>
                <Property Name="ProductID" Type="Edm.String" Nullable="false" MaxLength="16"/>
                <Property Name="Name" Type="Edm.String" Nullable="false" MaxLength="64"/>
                <Property Name="Warehouse" Type="Edm.String" Nullable="false" MaxLength="8"/>
                <Property Name="BinSequence" Type="Edm.Int32" Nullable="false"/>
                <Property Name="Active" Type="Edm.Boolean" Nullable="false"/>
                <Property Name="Region" Type="Edm.String" Nullable="true" MaxLength="8"/>
                <Property Name="Note" Type="Edm.String" Nullable="true" MaxLength="64"/>
                <NavigationProperty Name="Category" Relationship="Inventory.Products_Categories" FromRole="Product" ToRole="Category"/>
            </EntityType>
            <EntityType Name="Category">
                <Key>
                    <PropertyRef Name="CategoryID"/>
                </Key>
                <Property Name="CategoryID" Type="Edm.String" Nullable="false" MaxLength="16"/>
                <Property Name="CategoryName" Type="Edm.String" Nullable="false" MaxLength="64"/>
                <Property Name="Region" Type="Edm.String" Nullable="true" MaxLength="8"/>
            </EntityType>
            <Association Name="Products_Categories">
                <End Role="Category" Type="Inventory.Category" Multiplicity="0..1"/>
                <End Role="Product" Type="Inventory.Product" Multiplicity="*"/>
            </Association>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>
