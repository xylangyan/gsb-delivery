  "queries": [
    {
      "id": "rank",
      "sql": "\n                    WITH joined AS (\n                      SELECT l.bill_no, l.grp, r.event_time AS right_time,\n                             r.flow_id, r.display_value,\n                             ROW_NUMBER() OVER (\n                               PARTITION BY l.grp\n                               ORDER BY r.event_time, l.event_time, l.row_seq, r.flow_id\n                             ) AS rn\n                      FROM bill_left l\n                      LEFT JOIN flow_right r ON l.bill_no = r.bill_no\n                      WHERE l.event_time >= '2026-01-01'\n                    )\n                    SELECT grp, bill_no, flow_id, display_value, rn\n                    FROM joined\n                    WHERE rn = 1\n                    ORDER BY grp, bill_no\n                ",
      "expected": {
        "columns": [
          "grp",
          "bill_no",
          "flow_id",
          "display_value",
          "rn"
        ],
        "rows": [
          [
            "G1",
            "B1",
            "F1",
            "winner",
            1
          ],
          [
            "G2",
            "B3",
            "F3",
            null,
            1
          ],
          [
            "G3",
            "B4",
            null,
            null,
            1
          ]
        ]
      }
    },
    {
      "id": "match",
      "sql": "\n                    SELECT l.bill_no,\n                           CASE WHEN r.flow_id IS NOT NULL\n                                THEN 'matched' ELSE 'unmatched' END AS match_state,\n                           r.display_value\n                    FROM bill_left l\n                    LEFT JOIN flow_right r ON l.bill_no = r.bill_no\n                    WHERE l.event_time >= '2026-01-01'\n                    ORDER BY l.bill_no, r.flow_id\n                ",
      "expected": {
        "columns": [
          "bill_no",
          "match_state",
          "display_value"
        ],
        "rows": [
          [
            "B1",
            "matched",
            "winner"
          ],
          [
            "B2",
            "matched",
            null
          ],
          [
            "B3",
            "matched",
            null
          ],
          [
            "B4",
            "unmatched",
            null
          ],
          [
            "B4",
            "unmatched",
            null
          ]
        ]
      }
    },
